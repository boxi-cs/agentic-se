{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explain gate evidence 1.0",
  "description": "Structural feedback only. gate.validate_record additionally checks the evidence identity, one problem per question and status consistency. No account map, raw diff, explanation body, logs, grades or authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "pr_number",
    "milestone",
    "author_id",
    "evidence_id",
    "base_commit",
    "head_commit",
    "diff_sha256",
    "source",
    "explanation_sha256",
    "structure"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "maxLength": 200
    },
    "pr_number": {
      "type": "integer",
      "minimum": 1
    },
    "milestone": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
    },
    "author_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^eg:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+:[1-9][0-9]*:[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "head_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "diff_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "string",
      "pattern": "^(pr-body|comment:[1-9][0-9]*)$"
    },
    "explanation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "problems"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "needs_review"
          ]
        },
        "problems": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^q[1-4]:(missing|duplicate|empty|placeholder)$"
          }
        }
      }
    }
  }
}
